# Supabase Configuration (Required)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fairscore

# Optional: API Configuration
API_TIMEOUT=30
DEBUG=false

# AI Provider (choose one or both - auto-selected based on what's available)
# Option 1: Google Gemini (Free tier - requires project creation)
GEMINI_API_KEY=your-gemini-api-key-here

# Option 2: OpenAI-compatible endpoint
OPENAI_API_KEY=your-openai-compatible-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1  # Optional: change for other providers
OPENAI_MODEL=gpt-3.5-turbo  # Optional: change to your provider's model

# Note: If both are configured, Gemini takes priority.
# If Gemini fails with 403/access denied, app falls back to deterministic tips.
