# Supabase Configuration (Required)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fairscore

# Optional: API Configuration
API_TIMEOUT=30
DEBUG=false

# AI Provider Configuration
# Set AI_PROVIDER to explicitly choose: "gemini" or "openai"
# If not set, auto-detects based on available keys (Gemini > OpenAI)
AI_PROVIDER=gemini

# Option 1: Google Gemini (Free tier - requires project creation)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=models/gemini-1.5-flash  # or models/gemini-1.5-flash-001, models/gemini-1.5-pro, etc.

# Option 2: OpenAI-compatible endpoint
OPENAI_API_KEY=your-openai-compatible-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1  # Optional: change for other providers (Azure, local, etc.)
OPENAI_MODEL=gpt-3.5-turbo  # Optional: change to your provider's model

# Auth Token Secret (Required for production - generates secure HMAC tokens)
TOKEN_SECRET=your-secure-random-secret-here

# Model archive (Required when deploying - the trained models are a private GitHub release)
# MODEL_RELEASE_URL is the release asset API URL, e.g.
# https://api.github.com/repos/<owner>/<repo>/releases/assets/<asset_id>
MODEL_RELEASE_URL=your-model-release-asset-url-here
MODEL_GITHUB_TOKEN=your-github-token-with-repo-read-here

# Note: If AI_PROVIDER is not set, Gemini takes priority if its key exists.
# If the selected provider fails (403/rate limit), app falls back to deterministic tips.
